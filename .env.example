# Supabase (Project Settings → API). Begge er trygge å eksponere i nettlesaren – RLS vernar dataa.
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Claude API-nøkkel (berre på serveren, aldri NEXT_PUBLIC_). Utan denne er chatten avslått.
ANTHROPIC_API_KEY=

# Valfritt: byt modell for chatten, t.d. claude-haiku-5-5 for lågast kostnad
# ANTHROPIC_MODEL=claude-opus-5-5
